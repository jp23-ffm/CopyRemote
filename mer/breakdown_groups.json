{
  "persistent_days_threshold": 7,
  "dimensions": [
    {"field": "REGION", "label": "By region"},
    {"field": "OSSHORTNAME", "label": "By OS"},
    {"field": "LIVE_STATUS", "label": "By live status"},
    {"field": "SNOW_STATUS", "label": "By SNOW status"},
    {"field": "MACHINE_TYPE", "label": "By machine type"},
    {"field": "SNOW_SUPPORTGROUP", "label": "By support group"},
    {"field": "MANUFACTURER", "label": "By manufacturer"},
    {"field": "COUNTRY", "label": "By country"}
  ],
  "groups": {
    "OSFAMILY": {
      "buckets": {
        "Windows": ["Windows"],
        "Linux": ["Linux"],
        "VMware": []
      },
      "other_label": "Other"
    }
  },
  "pamela": {
    "techfamily_buckets": {
      "Linux": ["Linux Server", "Linux Workstation", "Unix Server"],
      "Windows": ["Windows Server"],
      "VMware": ["Hypervisor"]
    },
    "other_label": "Other"
  },
  "metrics": {
    "missing_data": {"breakdown": "dimensions"},
    "alive_inconsistent": {"breakdown": "cross"},
    "dead_inconsistent": {"breakdown": "cross"}
  },
  "display": {
    "default_percentage_mode": "clean",
    "recap_severity_thresholds": {
      "orange": 0,
      "red": 2
    },
    "recap_severity_colors": {
      "good": {"light": "#1b8a4a", "dark": "#4caf7d"},
      "warning": {"light": "#d4b106", "dark": "#ffe066"},
      "critical": {"light": "#c0392b", "dark": "#e07a6b"},
      "excel_good": "D4EDDA",
      "excel_warning": "FFEB3B",
      "excel_critical": "F8D7DA"
    },
    "pamela_report_types": [
      {"report_type": "missing_AD", "label": "Missing AD"},
      {"report_type": "missing_ADDM", "label": "Missing ADDM"},
      {"report_type": "missing_SA", "label": "Missing SA"},
      {"report_type": "missing_LA", "label": "Missing LA"},
      {"report_type": "missing_EPO", "label": "Missing EPO"},
      {"report_type": "missing_CA", "label": "Missing CA"}
    ]
  },
  "recap": {
    "bucket_field": "OSFAMILY",
    "row_fields": [
      {"field": "SNOW_STATUS", "label": "Operational Status"},
      {"field": "APP_NAME_VALUE", "label": "Application Name"},
      {"field": "SNOW_DATACENTER", "label": "Datacenter"},
      {"field": "MODEL", "label": "Model"},
      {"field": "INFRAVERSION", "label": "Infra Version"},
      {"field": "OSSHORTNAME", "label": "OSNAME"},
      {"field": "SERIAL", "label": "Serial"}
    ]
  }
